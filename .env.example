# Copy to .env — never commit real values (including Stripe *test* keys).

APP_ENV=development
APP_SECRET_KEY=replace-with-a-long-random-string

DATABASE_URL=postgresql+psycopg://billing:billing@localhost:5432/billing

# Stripe test mode only (sk_test_… / whsec_…). Leave placeholders to run
# unit tests without Stripe; fill in for Checkout + stripe listen.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PRO_PRICE_ID=price_replace_me
STRIPE_SUCCESS_URL=http://localhost:8000/v1/checkout/success
STRIPE_CANCEL_URL=http://localhost:8000/v1/checkout/cancel

# Public base URL used in Checkout success/cancel if the Stripe URLs above
# are left as defaults.
PUBLIC_BASE_URL=http://localhost:8000
